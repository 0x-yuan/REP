# Per-experiment env file. Copy to `experiment.env` and edit.
# `master/run_pipeline.sh` sources this automatically before any Modal call.
# Anything you set in your shell still wins over the values here.

# Namespace prefix for every Modal app / volume / dict this copy of the
# repo deploys. Set to a unique string per duplicated experiment so two
# parallel copies (e.g. exp-01/inference-farm and exp-02/inference-farm)
# never collide. Validation: [a-zA-Z0-9._-]{1,40}.
#
# Empty / unset = legacy unprefixed names (`sglang-slave-<m>`, `inference-farm-data`,
# `sglang-slave-checkpoints`). The HF cache volume is always shared.
EXP_ID=

# Optional throughput-knob pins. Most experiments leave these unset and
# let `master/run_pipeline.sh` use its built-in defaults.
# REPLICAS=1
# SGLANG_STALL_TIMEOUT_S=2400
# SHARD_FILES_MIN_ROWS=0
# WATCH=0
