# Per-experiment environment for the inference farm.
# Namespaces all Modal apps under EXP_ID so parallel experiments do not collide.
EXP_ID=rep-attack
# Long-tail decode (up to ~32k output tokens) needs a generous stall timeout.
SGLANG_STALL_TIMEOUT_S=7200
WATCH=0
# One inbox file per victim (<=1000 rows) is fine on a single replica; set a
# positive row threshold to pre-shard very large inbox files instead.
SHARD_FILES_MIN_ROWS=0
