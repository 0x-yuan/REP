# Copy to .env and fill in. Nothing here is committed (.env is gitignored).

# Hugging Face token — only needed to push harvested traces / student
# checkpoints, or to re-pull a dataset not vendored under public/data/.
HF_TOKEN=

# Default Modal workspace/profile used by the inference farm and the distill
# engine. Any command that shows <your-modal-profile> takes this value.
MODAL_PROFILE=<your-modal-profile>

# OpenRouter — the single external-API layer. Victims whose reasoning is served
# through an API (e.g. Gemma-4-31B, via message.reasoning) are harvested with
# steal-method/experiments/cross_victim/openrouter_runner.py using this key.
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
